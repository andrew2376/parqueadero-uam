
# Aplicación
NOMBRE_APLICACION=API Parqueadero LPR
ENTORNO=desarrollo
PREFIJO_API=/api/v1

# PostgreSQL
POSTGRES_DB=parqueadero
POSTGRES_USER=parqueadero
POSTGRES_PASSWORD=parqueadero_desarrollo

# Conexión desde FastAPI
URL_BASE_DATOS=postgresql+psycopg://parqueadero:parqueadero_desarrollo@localhost:5432/parqueadero

# Seguridad
SECRETO_JWT=cambiar-este-secreto-local
ALGORITMO_JWT=HS256

# Configuración adicional
UMBRAL_CONFIANZA_LECTURA=0.85
ZONA_HORARIA=America/Bogota
ORIGENES_PERMITIDOS=["http://localhost:4200"]

# Mercado Pago - credenciales de prueba
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com